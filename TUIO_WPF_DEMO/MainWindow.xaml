<Window x:Class="TUIO_WPF_DEMO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TUIO Cooking Assistant" 
        WindowState="Maximized"
        Background="#000040">
    <Grid>
        <!-- Context Display -->
        <TextBlock x:Name="ContextDisplay" 
                   Text="Context: Cooking Assistant" 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="Bold"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom" 
                   Margin="20"/>

        <!-- Recipe Overview Panel -->
        <Border x:Name="RecipePanel" Visibility="Collapsed" Background="#CC111111" CornerRadius="20" Padding="25" Margin="40"
                BorderBrush="Gold" BorderThickness="2" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="RecipeTitleText" Text="Recipe Title" Foreground="Gold" FontSize="36" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="RecipeOverviewText" Text="Overview text..." Foreground="White" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <TextBlock Text="INGREDIENTS" Foreground="#AAAAAA" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="RecipeIngredientsText" Text="• Ing 1" Foreground="White" FontSize="18" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <Border Background="#444444" CornerRadius="10" Padding="10">
                    <TextBlock Text="🔄 Rotate TUIO Right to Start Cooking" Foreground="Cyan" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Step-by-Step Instruction Panel -->
        <Border x:Name="StepPanel" Visibility="Collapsed" Background="#CC002040" CornerRadius="20" Padding="30" Margin="40"
                BorderBrush="Cyan" BorderThickness="3" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="StepNumberText" Text="STEP 1 OF 5" Foreground="Cyan" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock x:Name="StepInstructionText" Text="Instruction goes here..." Foreground="White" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="PrevStepHint" Text="⬅️ Swipe Left for Previous" Foreground="#88FFFFFF" FontSize="14" Margin="10,0"/>
                    <TextBlock x:Name="NextStepHint" Text="Swipe Right for Next ➡️" Foreground="#88FFFFFF" FontSize="14" Margin="10,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Timer Dashboard -->
        <Border x:Name="TimerDashboard" Background="#AA000000" CornerRadius="15" Padding="15" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏲️" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TimerDisplay" Text="00:00" Foreground="#00FF00" FontSize="36" FontWeight="Bold" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- Logout Popup Overlay -->
        <Grid x:Name="LogoutOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#333333" BorderBrush="White" BorderThickness="2" CornerRadius="20" 
                    Width="400" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LOGOUT?" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Confirm Button -->
                        <Border x:Name="BtnConfirmLogout" Background="#AAFF0000" CornerRadius="10" Width="120" Height="60" Margin="10">
                            <TextBlock Text="CONFIRM" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- Cancel Button -->
                        <Border x:Name="BtnCancelLogout" Background="#AA888888" CornerRadius="10" Width="120" Height="60" Margin="10">
                            <TextBlock Text="CANCEL" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="(Hold pointer to select)" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="MainCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
            <!-- TUIO Elements will be added here dynamically -->
        </Canvas>
    </Grid>
</Window>
