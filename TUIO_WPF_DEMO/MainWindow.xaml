<Window x:Class="TUIO_WPF_DEMO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gourmet Kitchen Assistant" 
        WindowState="Maximized"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="KitchenPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.05" ShadowDepth="10"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="280"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.03" ShadowDepth="5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Image/Texture Hint -->
        <Border Opacity="0.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F0F4F8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Context Display -->
        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="40,30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="🍳" FontSize="40" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock Text="KITCHEN HUB" Foreground="#999" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="ContextDisplay" 
                               Text="Please Log In" 
                               Foreground="#2C3E50" 
                               FontSize="28" 
                               FontWeight="ExtraBold"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="400,0,0,0">
                <Border x:Name="BtnAdminToggle" Visibility="Collapsed" Background="#E67E22" CornerRadius="12" Padding="20,10" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ADMIN" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Admin Choice Panel (Selection between Kitchen and Admin) -->
        <Grid x:Name="AdminChoicePanel" Visibility="Collapsed" Margin="40,120,40,40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="WELCOME, ADMIN WAEL" Foreground="#2C3E50" FontSize="36" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Select your workspace" Foreground="#95A5A6" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,50"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Kitchen Mode Card -->
                    <Border x:Name="BtnEnterKitchen" Style="{StaticResource KitchenPanel}" Width="300" Height="250" Margin="20" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="👨‍🍳" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="KITCHEN MODE" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Recipes &amp; Cooking" FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                            <Border x:Name="EnterKitchenProgress" Height="4" Background="#ECF0F1" Margin="20,0">
                                <Border x:Name="EnterKitchenBar" Width="0" Background="#27AE60" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Admin Mode Card -->
                    <Border x:Name="BtnEnterAdmin" Style="{StaticResource KitchenPanel}" Width="300" Height="250" Margin="20" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="ADMIN MODE" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="User Management" FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                            <Border x:Name="EnterAdminProgress" Height="4" Background="#ECF0F1" Margin="20,0">
                                <Border x:Name="EnterAdminBar" Width="0" Background="#E67E22" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Home Page: Recipe List -->

        <!-- Home Page: Recipe List -->
        <Grid x:Name="HomePanel" Visibility="Collapsed" Margin="40,120,40,40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="WHAT ARE WE COOKING TODAY?" Foreground="#34495E" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <UniformGrid x:Name="RecipeGrid" Columns="4">
                    <!-- Recipe 1 -->
                    <Border x:Name="RecipeCard1" Style="{StaticResource RecipeCardStyle}" Tag="1">
                        <StackPanel>
                            <Border Background="#FFF3E0" CornerRadius="10" Height="140" Margin="0,0,0,15">
                                <TextBlock Text="🍳" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="OMELETTE" Foreground="#2C3E50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Breakfast • 10m" Foreground="#95A5A6" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <Border x:Name="Progress1" Height="4" Background="#ECF0F1" Margin="0,20,0,0" CornerRadius="2">
                                <Border x:Name="Bar1" Width="0" Background="#F39C12" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Recipe 2 -->
                    <Border x:Name="RecipeCard2" Style="{StaticResource RecipeCardStyle}" Tag="2">
                        <StackPanel>
                            <Border Background="#E8F5E9" CornerRadius="10" Height="140" Margin="0,0,0,15">
                                <TextBlock Text="🍕" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PIZZA" Foreground="#2C3E50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lunch • 25m" Foreground="#95A5A6" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <Border x:Name="Progress2" Height="4" Background="#ECF0F1" Margin="0,20,0,0" CornerRadius="2">
                                <Border x:Name="Bar2" Width="0" Background="#27AE60" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Recipe 3 -->
                    <Border x:Name="RecipeCard3" Style="{StaticResource RecipeCardStyle}" Tag="3">
                        <StackPanel>
                            <Border Background="#E3F2FD" CornerRadius="10" Height="140" Margin="0,0,0,15">
                                <TextBlock Text="🍝" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PASTA" Foreground="#2C3E50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dinner • 20m" Foreground="#95A5A6" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <Border x:Name="Progress3" Height="4" Background="#ECF0F1" Margin="0,20,0,0" CornerRadius="2">
                                <Border x:Name="Bar3" Width="0" Background="#2980B9" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Recipe 4 -->
                    <Border x:Name="RecipeCard4" Style="{StaticResource RecipeCardStyle}" Tag="4">
                        <StackPanel>
                            <Border Background="#FCE4EC" CornerRadius="10" Height="140" Margin="0,0,0,15">
                                <TextBlock Text="🍰" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CAKE" Foreground="#2C3E50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dessert • 45m" Foreground="#95A5A6" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <Border x:Name="Progress4" Height="4" Background="#ECF0F1" Margin="0,20,0,0" CornerRadius="2">
                                <Border x:Name="Bar4" Width="0" Background="#D81B60" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="Hover over a card to select" Foreground="#BDC3C7" FontSize="16" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Recipe Overview Panel -->
        <Border x:Name="RecipePanel" Visibility="Collapsed" Style="{StaticResource KitchenPanel}" MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="RecipeTitleText" Text="RECIPE TITLE" Foreground="#2C3E50" FontSize="42" FontWeight="ExtraBold" Margin="0,0,0,15"/>
                <TextBlock x:Name="RecipeOverviewText" Text="Overview text..." Foreground="#7F8C8D" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="26"/>
                
                <Border Background="#F9F9F9" CornerRadius="15" Padding="20" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="INGREDIENTS" Foreground="#BDC3C7" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="RecipeIngredientsText" Text="• Ing 1" Foreground="#34495E" FontSize="18" LineHeight="32" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="BtnCancelRecipe" Background="#E74C3C" CornerRadius="12" Padding="15" Margin="10" Width="180">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✖️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CANCEL" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="CancelRecipeProgress" Height="4" Background="#33000000" Margin="0,10,0,0" CornerRadius="2">
                                <Border x:Name="CancelRecipeBar" Width="0" Background="White" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BtnStartCooking" Background="#27AE60" CornerRadius="12" Padding="15" Margin="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👨‍🍳" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="START COOKING" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="StartCookingProgress" Height="4" Background="#33000000" Margin="0,10,0,0" CornerRadius="2">
                                <Border x:Name="StartCookingBar" Width="0" Background="White" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Step-by-Step Instruction Panel -->
        <Border x:Name="StepPanel" Visibility="Collapsed" Style="{StaticResource KitchenPanel}" MaxWidth="850" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="#F1F8FF" HorizontalAlignment="Center" CornerRadius="8" Padding="12,5" Margin="0,0,0,25">
                    <TextBlock x:Name="StepNumberText" Text="STEP 1 OF 5" Foreground="#0366D6" FontSize="14" FontWeight="Black"/>
                </Border>
                
                <TextBlock x:Name="StepInstructionText" Text="Instruction goes here..." Foreground="#2C3E50" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" LineHeight="48"/>

                <!-- Home Cook Mode Badge (only visible for Home Cook users) -->
                <Border x:Name="HomeCookBadge" Visibility="Collapsed" Background="#FFF3CD" BorderBrush="#F39C12" BorderThickness="2"
                        CornerRadius="8" Padding="10,6" Margin="0,0,0,30" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🍳" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="HOME COOK MODE — Read every word carefully. No rush!" 
                                   Foreground="#856404" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.4">
                        <TextBlock x:Name="PrevStepHint" Text="⬅️ SWIPE LEFT" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold" Margin="20,0"/>
                        <TextBlock x:Name="NextStepHint" Text="SWIPE RIGHT ➡️" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold" Margin="20,0"/>
                    </StackPanel>
                </Grid>

                <!-- Stop Cooking / Exit Button -->
                <Border x:Name="BtnStopCooking" Background="#E74C3C" CornerRadius="12" Padding="20,10" Margin="0,40,0,0" Width="220" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🛑" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="STOP COOKING" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="StopCookingProgress" Height="4" Background="#33000000" Margin="0,10,0,0" CornerRadius="2">
                            <Border x:Name="StopCookingBar" Width="0" Background="White" HorizontalAlignment="Left" CornerRadius="2"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Rating Panel (Appears if positive emotion detected) -->
        <Border x:Name="RatingPanel" Visibility="Collapsed" Style="{StaticResource KitchenPanel}" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="GREAT JOB!" Foreground="#27AE60" FontSize="36" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="You seemed to enjoy that! How would you rate this recipe?" Foreground="#7F8C8D" FontSize="18" TextAlignment="Center" Margin="0,0,0,30"/>
                
                <UniformGrid Columns="5" Margin="0,0,0,30">
                    <Border x:Name="Star1" Tag="1" Background="Transparent" Padding="10">
                        <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Star2" Tag="2" Background="Transparent" Padding="10">
                        <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Star3" Tag="3" Background="Transparent" Padding="10">
                        <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Star4" Tag="4" Background="Transparent" Padding="10">
                        <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Star5" Tag="5" Background="Transparent" Padding="10">
                        <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center"/>
                    </Border>
                </UniformGrid>

                <!-- Shared Rating Progress Bar -->
                <Border x:Name="RatingProgress" Height="6" Background="#ECF0F1" CornerRadius="3" Margin="40,0">
                    <Border x:Name="RatingProgressBar" Width="0" Background="#F1C40F" HorizontalAlignment="Left" CornerRadius="3"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Dessert Inquiry Panel -->
        <Border x:Name="DessertInquiryPanel" Visibility="Collapsed" Style="{StaticResource KitchenPanel}" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="DINNER IS SERVED! 🍽️" Foreground="#2C3E50" FontSize="32" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Would you like to see a suggested dessert recipe to finish your meal?" Foreground="#7F8C8D" FontSize="18" TextAlignment="Center" Margin="0,0,0,40"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="BtnSeeDessert" Background="#E67E22" CornerRadius="12" Padding="25,15" Margin="15" Width="200">
                        <StackPanel>
                            <TextBlock Text="YES, PLEASE!" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border x:Name="SeeDessertProgress" Height="4" Background="#33000000" Margin="0,10,0,0" CornerRadius="2">
                                <Border x:Name="SeeDessertBar" Width="0" Background="White" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="BtnNoDessert" Background="#BDC3C7" CornerRadius="12" Padding="25,15" Margin="15" Width="200">
                        <StackPanel>
                            <TextBlock Text="NO, THANKS" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border x:Name="NoDessertProgress" Height="4" Background="#33000000" Margin="0,10,0,0" CornerRadius="2">
                                <Border x:Name="NoDessertBar" Width="0" Background="White" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Timer Dashboard -->
        <Border x:Name="TimerDashboard" Visibility="Collapsed" Background="White" CornerRadius="20" Padding="15,10" Margin="40,30" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#EEE" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.05" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏲️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="TimerDisplay" Text="00:00" Foreground="#2C3E50" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI Variable Display"/>
            </StackPanel>
        </Border>

        <!-- Admin Panel (Registration) -->
        <Border x:Name="AdminPanel" Visibility="Collapsed" Style="{StaticResource KitchenPanel}" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="ADMIN: NEW USER REGISTRATION" Foreground="#2C3E50" FontSize="32" FontWeight="ExtraBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="Instructions: Ask the new user to stand in front of the camera, then hover over the CAPTURE button." 
                           Foreground="#7F8C8D" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                    <TextBlock Text="NAME:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" Foreground="#2C3E50"/>
                    <StackPanel>
                        <TextBox x:Name="TxtNewUserName" Text="NewUser" FontSize="24" Padding="15,10" Width="300" BorderBrush="#DDD" BorderThickness="2">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Border x:Name="NameInputProgress" Height="6" Background="#11000000" Margin="0,5,0,0" CornerRadius="3" Width="300">
                            <Border x:Name="NameInputProgressBar" Width="0" Background="#3498DB" HorizontalAlignment="Left" CornerRadius="3"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="PROFESSION:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" Foreground="#2C3E50"/>
                    <Border x:Name="BtnAdminSelectHomeCook" Background="#EBF5FB" CornerRadius="10" Padding="15,10" Margin="5" Width="150" BorderBrush="#3498DB" BorderThickness="3">
                        <StackPanel>
                            <TextBlock Text="🍳 HOME COOK" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border x:Name="AdminSelectHomeCookBar" Height="4" Background="#11000000" Margin="0,8,0,0" CornerRadius="2">
                                <Border x:Name="AdminSelectHomeCookProgress" Width="0" Background="#3498DB" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="BtnAdminSelectChef" Background="#F9F9F9" CornerRadius="10" Padding="15,10" Margin="5" Width="150" BorderBrush="#DDD" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="👨‍🍳 CHEF" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border x:Name="AdminSelectChefBar" Height="4" Background="#11000000" Margin="0,8,0,0" CornerRadius="2">
                                <Border x:Name="AdminSelectChefProgress" Width="0" Background="#3498DB" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="BtnCapture" Background="#27AE60" CornerRadius="12" Padding="25,20" Margin="10" Width="300">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📸" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CAPTURE &amp; SAVE" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="CaptureProgress" Height="6" Background="#33000000" Margin="0,15,0,0" CornerRadius="3">
                                <Border x:Name="CaptureProgressBar" Width="0" Background="White" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- User Management List -->
                <TextBlock Text="EXISTING USERS" Foreground="#BDC3C7" FontSize="13" FontWeight="Bold" Margin="0,30,0,10" HorizontalAlignment="Left"/>
                <Border Background="#F9F9F9" CornerRadius="10" Padding="10" MaxHeight="300">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AdminUserListPanel">
                            <!-- User items will be injected here -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="BtnExitAdmin" Background="#95A5A6" CornerRadius="12" Padding="25,20" Margin="0,30,0,0" Width="300" HorizontalAlignment="Center" PreviewMouseLeftButtonDown="BtnExitAdmin_MouseDown">
                    <StackPanel>
                        <TextBlock Text="EXIT ADMIN MODE" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border x:Name="ExitAdminProgress" Height="6" Background="#33000000" Margin="0,10,0,0" CornerRadius="3">
                            <Border x:Name="ExitAdminProgressBar" Width="0" Background="White" HorizontalAlignment="Left" CornerRadius="3"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sign Up Panel -->
        <Border x:Name="SignUpPanel" Visibility="Collapsed" Style="{StaticResource KitchenPanel}" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Header -->
                <TextBlock x:Name="SignUpHeaderTitle" Text="CREATE YOUR KITCHEN PROFILE" Foreground="#2C3E50" FontSize="32" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="SignUpHeaderSubtitle" Text="Step 1: Tell us your name" Foreground="#7F8C8D" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- PHASE 1: WRITE NAME -->
                <StackPanel x:Name="SignUpPhase1Panel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock Text="NAME:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" Foreground="#2C3E50" FontSize="20"/>
                        <TextBox x:Name="TxtSignUpName" Text="" FontSize="24" Padding="15,10" Width="300" IsReadOnly="True" BorderBrush="#DDD" BorderThickness="2">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Hover and Select Button to Next Phase -->
                    <Border x:Name="BtnSignUpNext1" Background="#27AE60" CornerRadius="12" Padding="20,15" HorizontalAlignment="Center" Width="200">
                        <StackPanel>
                            <TextBlock Text="NEXT ➡️" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border x:Name="SignUpNext1Progress" Height="4" Background="#33000000" Margin="0,10,0,0" CornerRadius="2">
                                <Border x:Name="SignUpNext1Bar" Width="0" Background="White" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PHASE 2: SELECT PROFESSION -->
                <StackPanel x:Name="SignUpPhase2Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <!-- Home Cook Card -->
                        <Border x:Name="BtnSelectHomeCook" Style="{StaticResource KitchenPanel}" Width="250" Height="220" Margin="15" BorderBrush="#E0E0E0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🏠" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="HOME COOK" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                <TextBlock Text="Simple, healthy meals" FontSize="12" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                                <Border x:Name="SelectHomeCookProgress" Height="4" Background="#ECF0F1" Margin="10,0">
                                    <Border x:Name="SelectHomeCookBar" Width="0" Background="#2980B9" HorizontalAlignment="Left"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Chef Card -->
                        <Border x:Name="BtnSelectChef" Style="{StaticResource KitchenPanel}" Width="250" Height="220" Margin="15" BorderBrush="#E0E0E0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="👨‍🍳" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="CHEF" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                <TextBlock Text="Master the culinary arts" FontSize="12" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                                <Border x:Name="SelectChefProgress" Height="4" Background="#ECF0F1" Margin="10,0">
                                    <Border x:Name="SelectChefBar" Width="0" Background="#D35400" HorizontalAlignment="Left"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- PHASE 3: PHOTO COUNTDOWN -->
                <StackPanel x:Name="SignUpPhase3Panel" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock x:Name="SignUpCountdownText" Text="Get ready! Face the camera..." Foreground="#E74C3C" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock x:Name="SignUpCountdownTimer" Text="3" Foreground="#2C3E50" FontSize="72" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Logout Popup Overlay -->
        <Grid x:Name="LogoutOverlay" Visibility="Collapsed" Background="#88FFFFFF">
            <Border Style="{StaticResource KitchenPanel}" Width="450" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Finished Cooking?" Foreground="#2C3E50" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="BtnConfirmLogout" Background="#E74C3C" CornerRadius="12" Width="150" Height="70" Margin="15">
                            <TextBlock Text="LOGOUT" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="BtnCancelLogout" Background="#BDC3C7" CornerRadius="12" Width="150" Height="70" Margin="15">
                            <TextBlock Text="CANCEL" Foreground="White" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="MainCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
            <!-- TUIO Elements will be added here dynamically -->
        </Canvas>
    </Grid>
</Window>
